@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

@if (ViewBag.Error != null)
{
    <p class="text-danger">@ViewBag.Error</p>
}

<form action='@Url.Action("Login", "Cuenta")' method="POST">
    <div class="mb-3">
        <label for="nombreUsuario">Nombre de usuario</label>
        <input type="text" name="nombreUsuario" id="nombreUsuario" class="form-control" value="@ViewBag.NombreUsuario">
    </div>
    <div class="mb-3">
        <label for="contrasena">Contraseña</label>
        <input type="password" name="contrasena" id="contrasena" class="form-control">
    </div>
    <input type="submit" value="Entrar" class="btn btn-primary">
</form>

<p>¿No tenés cuenta? <a href='@Url.Action("Registro", "Cuenta")'>Crear cuenta</a></p>