
@{
    bool hayUsuario = Context.Session.GetString("IdUsuario") != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TP_Individual_prog</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP_Individual_prog.styles.css" asp-append-version="true" />
</head>
<body>
 
       <header class="encabezado">
    <a class="logo" href='@Url.Action("Index", "Home")'>Laboratorio de kits</a>

    <nav>
        @if (hayUsuario)
        {
            <a href='@Url.Action("Index", "Kits")'>Catálogo</a>
            <span>Hola, @Context.Session.GetString("Nombre")</span>
            <a href='@Url.Action("Logout", "Cuenta")'>Cerrar sesión</a>
        }
        else
        {
            <a href='@Url.Action("Login", "Cuenta")'>Iniciar sesión</a>
            <a href='@Url.Action("Registro", "Cuenta")'>Crear cuenta</a>
        }
    </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
